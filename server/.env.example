# Biến môi trường cho server Node.js
FRONTEND_ORIGIN=FRONTENDURL
PORT=PORTNUMBER
DB_HOST=LOCALHOST
DB_PORT=PORTNUMBER
DB_USER=USERNAME
DB_PASS=PASSWORD
DB_NAME=DATABASENAME
JWT_SECRET=your_very_strong_jwt_secret_key_at_least_32_chars
JWT_REFRESH_SECRET=your_very_strong_refresh_secret_key_at_least_32_chars
JWT_EXPIRES_IN=1d
JWT_COOKIE_EXPIRES_IN=1
COOKIE_SECRET=your_very_strong_cookie_secret_key_at_least_32_chars
# Bật/tắt xác thực (true/false)
AUTH_ENABLED=true