# Biến môi trường cho server Node.js
FRONTEND_ORIGIN='http://localhost:5173,http://localhost:8081,http://localhost:8080'
PORT=PORTNUMBER
DB_HOST=LOCALHOST
DB_PORT=PORTNUMBER
DB_USER=USERNAME
DB_PASS=PASSWORD
DB_NAME=DATABASENAME
JWT_SECRET=your_very_strong_jwt_secret_key_at_least_32_chars
JWT_REFRESH_SECRET=your_very_strong_refresh_secret_key_at_least_32_chars
JWT_EXPIRES_IN=1d
JWT_COOKIE_EXPIRES_IN=1
COOKIE_SECRET=your_very_strong_cookie_secret_key_at_least_32_chars
API_PREFIX=/api/v1
NODE_ENV=development
DEBUG_SCHEDULE_CHANGE=1
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
MAIL_FROM="No Reply" <no-reply@example.com>