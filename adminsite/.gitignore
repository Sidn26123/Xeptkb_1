# ============================================
# == Java / Maven / Gradle build artifacts ==
# ============================================
target/
build/
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*
# Allow Maven wrapper JAR
!.mvn/wrapper/maven-wrapper.jar

# Allow target folders under source
!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/build/
!**/src/test/**/build/

# =======================
# == Secret / Config ==
# =======================
.env
*.env
*secrets.yml
*.key
*.crt
*.pem
application-secrets.yml

# =======================
# == Log files ==
# =======================
*.log

