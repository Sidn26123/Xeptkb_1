npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node.js (nếu bạn dùng frontend như React/Vite)
node_modules/
*.node_modules/
dist/
*.dist/
dist-ssr/
*.local

